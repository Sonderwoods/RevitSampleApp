{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cloudburst",
  "version": "0.1.0",
  "identifier": "dk.cloudburst.desktop",
  "build": {
    "frontendDist": "../../Web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Cloudburst – rainwater screening",
        "width": 1500,
        "height": 950,
        "minWidth": 1024,
        "minHeight": 680,
        "center": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "Cloudburst",
    "shortDescription": "Rainwater / cloudburst screening",
    "longDescription": "Where does the water go? Bluespot screening and 2D cloudburst simulation on the same engine as the Rhino and Revit plug-ins.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.ico"],
    "resources": { "plugins/": "plugins/" },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "installerHooks": "installer-hooks.nsh" }
    }
  }
}
