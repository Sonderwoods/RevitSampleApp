<UserControl x:Class="Cloudburst.UI.CloudburstPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Cloudburst.UI.Controls"
             xmlns:inf="clr-namespace:Cloudburst.UI.Infrastructure"
             MinWidth="320" UseLayoutRounding="True" SnapsToDevicePixels="True">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Cloudburst.UI;component/Themes/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <inf:BoolToVisibilityConverter x:Key="Vis"/>
            <inf:BoolToVisibilityConverter x:Key="VisNot" Invert="True"/>
            <inf:HasValueToVisibilityConverter x:Key="Has"/>
            <inf:HasValueToVisibilityConverter x:Key="HasNot" Invert="True"/>
            <inf:IntEqualsConverter x:Key="IntEq"/>
            <inf:NotConverter x:Key="Not"/>

            <!-- Stepper item -->
            <Style x:Key="Item.Step" TargetType="ListBoxItem">
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="ToolTip" Value="{Binding Description}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Grid Background="Transparent">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="34"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="LineL" Height="2" Background="{StaticResource B.Border}" VerticalAlignment="Center"/>
                                <Border x:Name="LineR" Grid.Column="1" Height="2" Background="{StaticResource B.Border}" VerticalAlignment="Center"/>
                                <Ellipse x:Name="Halo" Grid.ColumnSpan="2" Width="34" Height="34" Fill="{StaticResource B.AccentSoft}" Visibility="Collapsed"/>
                                <Ellipse x:Name="Dot" Grid.ColumnSpan="2" Width="26" Height="26" Fill="{StaticResource B.Surface2}"
                                         Stroke="{StaticResource B.BorderStrong}" StrokeThickness="1.5"/>
                                <TextBlock x:Name="Num" Grid.ColumnSpan="2" Text="{Binding Number}" FontSize="11.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource B.TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock x:Name="Tick" Grid.ColumnSpan="2" Text="&#xE73E;" FontFamily="{StaticResource F.Icon}" FontSize="11"
                                           Foreground="{StaticResource B.Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                <TextBlock x:Name="Lbl" Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Title}" FontSize="10.5"
                                           Foreground="{StaticResource B.TextMuted}" HorizontalAlignment="Center" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsFirst}" Value="True">
                                    <Setter TargetName="LineL" Property="Visibility" Value="Hidden"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsLast}" Value="True">
                                    <Setter TargetName="LineR" Property="Visibility" Value="Hidden"/>
                                </DataTrigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Dot" Property="Stroke" Value="{StaticResource B.TextFaint}"/>
                                    <Setter TargetName="Lbl" Property="Foreground" Value="{StaticResource B.Text}"/>
                                </Trigger>
                                <DataTrigger Binding="{Binding IsDone}" Value="True">
                                    <Setter TargetName="Dot" Property="Fill" Value="{StaticResource B.AccentSoft}"/>
                                    <Setter TargetName="Dot" Property="Stroke" Value="{StaticResource B.AccentLine}"/>
                                    <Setter TargetName="Num" Property="Visibility" Value="Collapsed"/>
                                    <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="LineR" Property="Background" Value="{StaticResource B.AccentLine}"/>
                                </DataTrigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Halo" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="Dot" Property="Fill" Value="{StaticResource B.AccentGradient}"/>
                                    <Setter TargetName="Dot" Property="Stroke" Value="Transparent"/>
                                    <Setter TargetName="Num" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="Num" Property="Foreground" Value="{StaticResource B.White}"/>
                                    <Setter TargetName="Tick" Property="Visibility" Value="Collapsed"/>
                                    <Setter TargetName="Lbl" Property="Foreground" Value="{StaticResource B.Text}"/>
                                    <Setter TargetName="Lbl" Property="FontWeight" Value="SemiBold"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Pick row (Site step) -->
            <DataTemplate x:Key="PickRow">
                <Border Padding="0,8" BorderBrush="{StaticResource B.Border}" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border x:Name="IconTile" Width="32" Height="32" CornerRadius="9" Background="{StaticResource B.Surface3}" Margin="0,0,10,0" VerticalAlignment="Center">
                            <TextBlock x:Name="Ico" Text="{Binding Glyph}" Style="{StaticResource T.Icon}" Foreground="{StaticResource B.TextMuted}"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource B.Text}"/>
                                <Border Style="{StaticResource Chip}" Margin="7,0,0,0" Padding="7,1" Background="{StaticResource B.AccentSoft}"
                                        Visibility="{Binding HasItems, Converter={StaticResource Vis}}">
                                    <TextBlock Text="{Binding Count}" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource B.Accent}"/>
                                </Border>
                                <TextBlock Text="optional" Margin="7,0,0,0" FontSize="10.5" Foreground="{StaticResource B.TextFaint}" VerticalAlignment="Center">
                                    <TextBlock.Visibility>
                                        <MultiBinding Converter="{x:Static inf:OptionalChip.Instance}">
                                            <Binding Path="IsOptional"/>
                                            <Binding Path="HasItems"/>
                                        </MultiBinding>
                                    </TextBlock.Visibility>
                                </TextBlock>
                            </StackPanel>
                            <TextBlock Text="{Binding SubText}" FontSize="11" Foreground="{StaticResource B.TextMuted}" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding SubText}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                            <Button Style="{StaticResource Btn.Icon}" c:Ix.Glyph="&#xE711;" Command="{Binding ClearCommand}" ToolTip="Clear the picked objects"
                                    Visibility="{Binding HasItems, Converter={StaticResource Vis}}"/>
                            <Button x:Name="PickBtn" Content="{Binding PickLabel}" Padding="12,5" Margin="4,0,0,0" Command="{Binding PickCommand}"
                                    ToolTip="Select objects in the model"/>
                        </StackPanel>
                        <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,8,0,0" Visibility="{Binding ShowsHeight, Converter={StaticResource Vis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="96"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Height for the next pick (negative = channel)" FontSize="11" Foreground="{StaticResource B.TextMuted}"
                                       VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0"/>
                            <TextBox Grid.Column="1" Text="{Binding HeightCm, StringFormat=0.#}" c:Ix.Suffix="cm" MinHeight="28" Padding="8,4"/>
                        </Grid>
                    </Grid>
                </Border>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding HasItems}" Value="True">
                        <Setter TargetName="IconTile" Property="Background" Value="{StaticResource B.AccentSoft}"/>
                        <Setter TargetName="Ico" Property="Foreground" Value="{StaticResource B.Accent}"/>
                        <Setter TargetName="PickBtn" Property="Style" Value="{StaticResource Btn.Ghost}"/>
                    </DataTrigger>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding HasItems}" Value="False"/>
                            <Condition Binding="{Binding IsOptional}" Value="False"/>
                        </MultiDataTrigger.Conditions>
                        <Setter TargetName="PickBtn" Property="Style" Value="{StaticResource Btn.Accent}"/>
                    </MultiDataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <DataTemplate x:Key="MaterialRow">
                <Grid ToolTip="{Binding Tooltip}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="16" Height="16" CornerRadius="4" Background="{Binding Brush}" BorderBrush="#30FFFFFF" BorderThickness="1"
                            Margin="0,1,10,0" VerticalAlignment="Top"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Name}" FontSize="12" Foreground="{StaticResource B.Text}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding KeyValues}" FontSize="10.5" Foreground="{StaticResource B.TextMuted}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                    </StackPanel>
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="MaterialCombo">
                <StackPanel Orientation="Horizontal">
                    <Border Width="12" Height="12" CornerRadius="3" Background="{Binding Brush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </DataTemplate>

            <DataTemplate x:Key="RainCard">
                <StackPanel>
                    <Path Data="{StaticResource G.Drop}" Fill="{StaticResource B.Accent}" Width="11" Height="13" Stretch="Uniform" HorizontalAlignment="Left"/>
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,6,16,0"
                               Foreground="{StaticResource B.Text}" ToolTip="{Binding Event.Description}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <TextBlock Text="{Binding DepthText}" FontFamily="{StaticResource F.Display}" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource B.Text}"/>
                        <TextBlock Text="mm" Foreground="{StaticResource B.TextMuted}" Margin="3,0,0,4" VerticalAlignment="Bottom" FontSize="11"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Subtitle}" FontSize="10.5" Foreground="{StaticResource B.TextMuted}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </DataTemplate>

            <Style x:Key="Metric.Label" TargetType="TextBlock">
                <Setter Property="FontSize" Value="10.5"/>
                <Setter Property="Foreground" Value="{StaticResource B.TextMuted}"/>
            </Style>
            <Style x:Key="Metric.Value" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource B.Text}"/>
                <Setter Property="Margin" Value="0,2,0,0"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            </Style>
            <Style x:Key="CardIcon" TargetType="Border">
                <Setter Property="Width" Value="30"/>
                <Setter Property="Height" Value="30"/>
                <Setter Property="CornerRadius" Value="9"/>
                <Setter Property="Background" Value="{StaticResource B.AccentSoft}"/>
                <Setter Property="Margin" Value="0,0,10,0"/>
                <Setter Property="VerticalAlignment" Value="Top"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid x:Name="Root" Background="{StaticResource B.Bg}"
          TextElement.FontFamily="{StaticResource F.Ui}" TextElement.FontSize="12" TextElement.Foreground="{StaticResource B.Text}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============================== HEADER ============================== -->
        <Border Background="{StaticResource B.HeaderGradient}" Padding="16,14,14,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="38" Height="38" CornerRadius="11" Background="{StaticResource B.AccentGradient}" Margin="0,0,12,0">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="14" ShadowDepth="0" Opacity="0.45" Color="#22C3EE"/>
                    </Border.Effect>
                    <Grid>
                        <Path Data="{StaticResource G.Cloud}" Fill="#E6FFFFFF" Width="20" Height="14" Stretch="Uniform" VerticalAlignment="Top" Margin="0,8,0,0"/>
                        <Path Data="{StaticResource G.Drop}" Fill="#FFFFFF" Width="7" Height="9" Stretch="Uniform" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,7,5"/>
                        <Path Data="{StaticResource G.Drop}" Fill="#B3FFFFFF" Width="6" Height="8" Stretch="Uniform" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="9,0,0,4"/>
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Cloudburst" FontFamily="{StaticResource F.Display}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource B.Text}"/>
                    <TextBlock Text="Rainwater screening" FontSize="11.5" Foreground="{StaticResource B.TextMuted}" Margin="0,1,0,0"/>
                </StackPanel>
                <Border Grid.Column="2" Style="{StaticResource Chip}" Background="{StaticResource B.Surface2}" BorderBrush="{StaticResource B.Border}"
                        BorderThickness="1" Padding="9,4" CornerRadius="12" VerticalAlignment="Center" ToolTip="{Binding EngineVersion}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="EngineDot" Width="7" Height="7" Margin="0,0,7,0" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource B.Good}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding EngineOk}" Value="False">
                                            <Setter Property="Fill" Value="{StaticResource B.Danger}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding HostName}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource B.TextMuted}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ============================== STEPPER ============================== -->
        <Border Grid.Row="1" Padding="8,4,8,10" BorderBrush="{StaticResource B.Border}" BorderThickness="0,0,0,1">
            <ListBox ItemsSource="{Binding Steps}" SelectedIndex="{Binding CurrentStepIndex, Mode=TwoWay}"
                     Style="{StaticResource List.Plain}" ItemContainerStyle="{StaticResource Item.Step}"
                     KeyboardNavigation.DirectionalNavigation="Cycle">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>
        </Border>

        <!-- busy line -->
        <ProgressBar Grid.Row="2" Height="2" IsIndeterminate="{Binding IsBusy}" Background="Transparent"
                     Visibility="{Binding IsBusy, Converter={StaticResource Vis}}"/>

        <!-- ============================== CONTENT ============================== -->
        <ScrollViewer x:Name="MainScroll" Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="14,14,6,8">
            <StackPanel Margin="0,0,6,0">

                <!-- engine failure banner -->
                <Border Style="{StaticResource Card}" Background="{StaticResource B.DangerSoft}" BorderBrush="{StaticResource B.DangerLine}"
                        Visibility="{Binding EngineOk, Converter={StaticResource VisNot}}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="&#xE783;" Style="{StaticResource T.Icon}" Foreground="{StaticResource B.Danger}" Margin="0,1,10,0" VerticalAlignment="Top"/>
                        <StackPanel>
                            <TextBlock Text="Engine not available" FontWeight="SemiBold" Foreground="{StaticResource B.Danger}"/>
                            <TextBlock Text="{Binding EngineError}" Style="{StaticResource T.Muted}" Margin="0,3,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- ======================= 1 SITE ======================= -->
                <StackPanel Visibility="{Binding CurrentStepIndex, Converter={StaticResource IntEq}, ConverterParameter=0}">
                    <StackPanel Margin="2,0,0,14">
                        <TextBlock Text="Site" Style="{StaticResource T.H1}"/>
                        <TextBlock Text="{Binding Steps[0].Description}" Style="{StaticResource T.Muted}" Margin="0,3,0,0"/>
                    </StackPanel>

                    <!-- sample library -->
                    <Border Style="{StaticResource Card}" Background="{StaticResource B.HeroGradient}" BorderBrush="{StaticResource B.AccentLine}" Padding="14,12,14,8">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <Border Style="{StaticResource CardIcon}">
                                    <TextBlock Text="&#xE80F;" Style="{StaticResource T.Icon}" FontSize="13" Foreground="{StaticResource B.Accent}"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Load a sample" Style="{StaticResource T.H2}"/>
                                    <TextBlock Text="Creates the site in the model, picks the matching rain and builds the grid" Style="{StaticResource T.Muted}" FontSize="11"/>
                                </StackPanel>
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding Samples}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="Row" CornerRadius="10" Padding="10,8" Margin="0,4,0,0" Background="{StaticResource B.Surface2}"
                                                BorderBrush="{StaticResource B.Border}" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel x:Name="Texts" Margin="0,0,8,0">
                                                    <WrapPanel>
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12.5" Margin="0,0,7,0" Foreground="{StaticResource B.Text}"/>
                                                        <Border x:Name="Badge" CornerRadius="8" Padding="7,1" Background="{StaticResource B.Surface4}" VerticalAlignment="Center">
                                                            <TextBlock x:Name="BadgeText" Text="{Binding Badge}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource B.TextMuted}"/>
                                                        </Border>
                                                    </WrapPanel>
                                                    <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{StaticResource B.TextMuted}" TextWrapping="Wrap"
                                                               MaxHeight="30" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" ToolTip="{Binding Description}"/>
                                                    <TextBlock Text="{Binding UnavailableHint}" FontSize="10.5" Foreground="{StaticResource B.Warn}" TextWrapping="Wrap" Margin="0,3,0,0"
                                                               Visibility="{Binding UnavailableHint, Converter={StaticResource Has}}"/>
                                                    <TextBlock Text="{Binding CompareHint}" FontSize="10.5" Foreground="{StaticResource B.Accent}" TextWrapping="Wrap" Margin="0,3,0,0"
                                                               Visibility="{Binding CompareHint, Converter={StaticResource Has}}"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" x:Name="LoadBtn" Style="{StaticResource Btn.Primary}" Content="Load" Padding="12,6" VerticalAlignment="Center"
                                                        Command="{Binding LoadCommand}"/>
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsReal}" Value="True">
                                                <Setter TargetName="Badge" Property="Background" Value="{StaticResource B.GoodSoft}"/>
                                                <Setter TargetName="BadgeText" Property="Foreground" Value="{StaticResource B.Good}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsBeforeAfter}" Value="True">
                                                <Setter TargetName="Badge" Property="Background" Value="{StaticResource B.AccentSoft}"/>
                                                <Setter TargetName="BadgeText" Property="Foreground" Value="{StaticResource B.Accent}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                                <Setter TargetName="Texts" Property="Opacity" Value="0.55"/>
                                                <Setter TargetName="LoadBtn" Property="Style" Value="{StaticResource Btn.Secondary}"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- picks -->
                    <Border Style="{StaticResource Card}" Padding="14,12,14,6">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,4">
                                <Border Style="{StaticResource CardIcon}">
                                    <TextBlock Text="&#xE81E;" Style="{StaticResource T.Icon}" FontSize="13" Foreground="{StaticResource B.Accent}"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Site geometry" Style="{StaticResource T.H2}"/>
                                    <TextBlock Text="{Binding HostName, StringFormat='Pick objects in {0}'}" Style="{StaticResource T.Muted}" FontSize="11"/>
                                </StackPanel>
                            </DockPanel>
                            <!-- hosts that can read the site from the model (Revit): one button instead of picking each role -->
                            <StackPanel Margin="0,6,0,8" Visibility="{Binding CanAutoSite, Converter={StaticResource Vis}}">
                                <Button Style="{StaticResource Btn.Primary}" Content="{Binding AutoSiteLabel}" c:Ix.Glyph="&#xE8B3;" Padding="12,7"
                                        HorizontalAlignment="Stretch" Command="{Binding AutoSiteCommand}"/>
                                <TextBlock Text="{Binding AutoSiteHint}" Style="{StaticResource T.Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                <TextBlock Text="Or pick by hand below to override." Style="{StaticResource T.Muted}" FontSize="11" Margin="0,2,0,0"/>
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding PickItems}" ItemTemplate="{StaticResource PickRow}" Focusable="False"/>

                            <!-- DHM rasters -->
                            <Grid Margin="0,10,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="DHM terrain rasters" FontWeight="SemiBold" FontSize="12.5"/>
                                    <TextBlock Text="GeoTIFF or ASCII grid, used in addition to picked terrain" FontSize="11" Foreground="{StaticResource B.TextMuted}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="Import…" c:Ix.Glyph="&#xE8E5;" Padding="11,5" Command="{Binding ImportTerrainFilesCommand}"
                                        ToolTip="Import DHM terrain (GeoTIFF / ASC)…"/>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding TerrainFiles}" Focusable="False" Margin="0,0,0,6"
                                          Visibility="{Binding HasTerrainFiles, Converter={StaticResource Vis}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource B.AccentSoft}" BorderBrush="{StaticResource B.AccentLine}" BorderThickness="1"
                                                CornerRadius="12" Padding="9,2,3,2" Margin="0,0,6,6" ToolTip="{Binding Path}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE81E;" FontFamily="{StaticResource F.Icon}" FontSize="10" Foreground="{StaticResource B.Accent}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBlock Text="{Binding Name}" FontSize="11" Foreground="{StaticResource B.Text}" VerticalAlignment="Center" MaxWidth="200" TextTrimming="CharacterEllipsis"/>
                                                <Button Style="{StaticResource Btn.Icon}" Width="20" Height="20" Padding="0" c:Ix.Glyph="&#xE711;" c:Ix.GlyphSize="9"
                                                        Command="{Binding RemoveCommand}" Margin="4,0,0,0" ToolTip="Remove"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- grid settings -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,12">
                                <Border Style="{StaticResource CardIcon}">
                                    <TextBlock Text="&#xE80A;" Style="{StaticResource T.Icon}" FontSize="13" Foreground="{StaticResource B.Accent}"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Analysis grid" Style="{StaticResource T.H2}"/>
                                    <TextBlock Text="Smaller cells: more detail, slower runs" Style="{StaticResource T.Muted}" FontSize="11"/>
                                </StackPanel>
                            </DockPanel>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Cell size" Style="{StaticResource T.Label}"/>
                                <TextBlock Grid.Column="1" Text="{Binding CellSizeText}" FontWeight="SemiBold" Foreground="{StaticResource B.Accent}"/>
                            </Grid>
                            <Slider Minimum="0.25" Maximum="5" TickFrequency="0.25" IsSnapToTickEnabled="True" SmallChange="0.25" LargeChange="0.5"
                                    Value="{Binding CellSize, Mode=TwoWay}"/>
                            <Grid Margin="0,0,0,2">
                                <TextBlock Text="0.25 m" FontSize="10" Foreground="{StaticResource B.TextFaint}"/>
                                <TextBlock Text="5 m" FontSize="10" Foreground="{StaticResource B.TextFaint}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Border CornerRadius="8" Padding="9,6" Margin="0,6,0,0" Background="{StaticResource B.Surface2}">
                                <DockPanel>
                                    <TextBlock x:Name="EstIcon" DockPanel.Dock="Left" Text="&#xE946;" FontFamily="{StaticResource F.Icon}" FontSize="12"
                                               Margin="0,1,8,0" VerticalAlignment="Top" Foreground="{StaticResource B.TextMuted}"/>
                                    <TextBlock Text="{Binding CellEstimateText}" FontSize="11.5" TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource B.TextMuted}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CellEstimateTone}" Value="Good">
                                                        <Setter Property="Foreground" Value="{StaticResource B.Text}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding CellEstimateTone}" Value="Warn">
                                                        <Setter Property="Foreground" Value="{StaticResource B.Warn}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding CellEstimateTone}" Value="Danger">
                                                        <Setter Property="Foreground" Value="{StaticResource B.Danger}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DockPanel>
                            </Border>

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                    <TextBlock Text="Building min. height" FontWeight="SemiBold" FontSize="12"/>
                                    <TextBlock Text="Lower objects are treated as terrain" FontSize="11" Foreground="{StaticResource B.TextMuted}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <TextBox Grid.Column="1" Text="{Binding BuildingMinHeight, StringFormat=0.0#}" c:Ix.Suffix="m" VerticalAlignment="Center"/>
                            </Grid>

                            <Border CornerRadius="8" Padding="10,7" Margin="0,12,0,0" Background="{StaticResource B.WarnSoft}"
                                    Visibility="{Binding GridStale, Converter={StaticResource Vis}}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left" Text="&#xE7BA;" FontFamily="{StaticResource F.Icon}" Foreground="{StaticResource B.Warn}" Margin="0,1,8,0"/>
                                    <TextBlock Text="Inputs changed since the grid was built – rebuild to apply them." FontSize="11.5" Foreground="{StaticResource B.Warn}" TextWrapping="Wrap"/>
                                </DockPanel>
                            </Border>

                            <Button Style="{StaticResource Btn.Big}" Content="Build grid" c:Ix.Glyph="&#xE80A;" Margin="0,12,0,0"
                                    HorizontalAlignment="Stretch" Command="{Binding BuildGridCommand}"/>
                        </StackPanel>
                    </Border>

                    <!-- grid stats -->
                    <Border Style="{StaticResource Card}" Visibility="{Binding HasGrid, Converter={StaticResource Vis}}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding GridDimsText}" FontSize="11" Foreground="{StaticResource B.TextMuted}" VerticalAlignment="Center"/>
                                <TextBlock Text="Grid ready" Style="{StaticResource T.H2}"/>
                            </DockPanel>
                            <UniformGrid Columns="3" Margin="-3,0">
                                <c:StatTile Label="Cells" Value="{Binding GridCellsText}" Tone="Accent"/>
                                <c:StatTile Label="Area" Value="{Binding GridAreaText}" Unit="km²"/>
                                <c:StatTile Label="Built in" Value="{Binding GridBuildText}" Unit="ms"/>
                            </UniformGrid>
                            <ItemsControl ItemsSource="{Binding GridWarnings}" Margin="0,8,0,0" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="8" Padding="9,6" Margin="0,4,0,0" Background="{StaticResource B.WarnSoft}">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Left" Text="&#xE7BA;" FontFamily="{StaticResource F.Icon}" FontSize="12" Foreground="{StaticResource B.Warn}" Margin="0,1,8,0" VerticalAlignment="Top"/>
                                                <TextBlock Text="{Binding}" FontSize="11.5" Foreground="{StaticResource B.Text}" TextWrapping="Wrap"/>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ======================= 2 SURFACES ======================= -->
                <StackPanel Visibility="{Binding CurrentStepIndex, Converter={StaticResource IntEq}, ConverterParameter=1}">
                    <StackPanel Margin="2,0,0,14">
                        <TextBlock Text="Surfaces" Style="{StaticResource T.H1}"/>
                        <TextBlock Text="{Binding Steps[1].Description}" Style="{StaticResource T.Muted}" Margin="0,3,0,0"/>
                    </StackPanel>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,10">
                                <Border Style="{StaticResource CardIcon}">
                                    <TextBlock Text="&#xE790;" Style="{StaticResource T.Icon}" FontSize="13" Foreground="{StaticResource B.Accent}"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Material palette" Style="{StaticResource T.H2}"/>
                                    <TextBlock Text="C = share of rain that runs off · n = roughness (Manning) · f = how fast water soaks in" Style="{StaticResource T.Muted}" FontSize="10.5" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DockPanel>
                            <Border Background="{StaticResource B.AccentSoft}" CornerRadius="8" Padding="10,7" Margin="0,0,0,8"
                                    Visibility="{Binding HasSelectionInfo, Converter={StaticResource Vis}}">
                                <DockPanel>
                                    <TextBlock Text="&#xE8B3;" Style="{StaticResource T.Icon}" FontSize="12" Foreground="{StaticResource B.Accent}" Margin="0,1,8,0" VerticalAlignment="Top"/>
                                    <TextBlock Text="{Binding SelectionText}" TextWrapping="Wrap" FontSize="11.5"/>
                                </DockPanel>
                            </Border>
                            <Grid>
                                <TextBox Text="{Binding MaterialSearch, UpdateSourceTrigger=PropertyChanged}" c:Ix.Placeholder="Search materials…" Padding="30,6,9,6"/>
                                <TextBlock Text="&#xE721;" FontFamily="{StaticResource F.Icon}" FontSize="12" Foreground="{StaticResource B.TextFaint}"
                                           Margin="11,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False"/>
                            </Grid>
                            <Border Style="{StaticResource Inset}" Padding="4" Margin="0,8,0,0">
                                <ListBox Style="{StaticResource List.Scroll}" MaxHeight="300" ItemsSource="{Binding MaterialsView}"
                                         SelectedItem="{Binding SelectedMaterial, Mode=TwoWay}" ItemContainerStyle="{StaticResource Item.Row}"
                                         ItemTemplate="{StaticResource MaterialRow}">
                                    <ListBox.GroupStyle>
                                        <GroupStyle>
                                            <GroupStyle.HeaderTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Name}" Style="{StaticResource T.Overline}" Margin="8,8,0,3"/>
                                                </DataTemplate>
                                            </GroupStyle.HeaderTemplate>
                                        </GroupStyle>
                                    </ListBox.GroupStyle>
                                </ListBox>
                            </Border>

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button Style="{StaticResource Btn.Primary}" c:Ix.Glyph="&#xE8B3;" Command="{Binding AssignMaterialCommand}"
                                        ToolTip="Select closed curves, hatches, surfaces or floors in the model">
                                    <TextBlock Text="Assign to selection" TextTrimming="CharacterEllipsis"/>
                                </Button>
                                <Button Grid.Column="2" Content="Auto-assign" c:Ix.Glyph="&#xE945;" Command="{Binding AutoAssignCommand}"
                                        ToolTip="Guess materials from layer, material and object names (English and Danish)"/>
                            </Grid>
                            <TextBlock Margin="0,6,0,0" FontSize="11" Foreground="{StaticResource B.TextMuted}" TextWrapping="Wrap"
                                       Visibility="{Binding HasSelectedMaterial, Converter={StaticResource VisNot}}"
                                       Text="Select a material above, then assign it to objects in the model."/>

                            <!-- edit values -->
                            <Expander Margin="-4,8,0,0" Visibility="{Binding HasSelectedMaterial, Converter={StaticResource Vis}}">
                                <Expander.Header>
                                    <TextBlock FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                                        <Run Text="Edit values ·"/>
                                        <Run Text="{Binding SelectedMaterial.Name, Mode=OneWay}" Foreground="{StaticResource B.Accent}"/>
                                    </TextBlock>
                                </Expander.Header>
                                <Border Style="{StaticResource Inset}" Margin="4,0,0,0">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <StackPanel Margin="0,0,0,8">
                                                <TextBlock Text="C cloudburst, sand" Style="{StaticResource T.Label}"/>
                                                <TextBox Text="{Binding SelectedMaterial.CCloudburstSand, StringFormat=0.0#}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Margin="0,0,0,8">
                                                <TextBlock Text="C cloudburst, clay" Style="{StaticResource T.Label}"/>
                                                <TextBox Text="{Binding SelectedMaterial.CCloudburstClay, StringFormat=0.0#}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="1" Margin="0,0,0,8">
                                                <TextBlock Text="Manning n" Style="{StaticResource T.Label}"/>
                                                <TextBox Text="{Binding SelectedMaterial.ManningN, StringFormat=0.0##}" c:Ix.Suffix="s/m⅓"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,8">
                                                <TextBlock Text="C normal" Style="{StaticResource T.Label}"/>
                                                <TextBox Text="{Binding SelectedMaterial.CNormal, StringFormat=0.0#}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="2" Margin="0,0,0,8">
                                                <TextBlock Text="Infiltration, sand" Style="{StaticResource T.Label}"/>
                                                <TextBox Text="{Binding SelectedMaterial.InfiltrationSand, StringFormat=0.#}" c:Ix.Suffix="mm/h"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,8">
                                                <TextBlock Text="Infiltration, clay" Style="{StaticResource T.Label}"/>
                                                <TextBox Text="{Binding SelectedMaterial.InfiltrationClay, StringFormat=0.#}" c:Ix.Suffix="mm/h"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="3">
                                                <TextBlock Text="Initial loss" Style="{StaticResource T.Label}"/>
                                                <TextBox Text="{Binding SelectedMaterial.InitialLossMm, StringFormat=0.#}" c:Ix.Suffix="mm"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="3" Grid.Column="2">
                                                <TextBlock Text="Extra storage" Style="{StaticResource T.Label}"/>
                                                <TextBox Text="{Binding SelectedMaterial.StorageMm, StringFormat=0.#}" c:Ix.Suffix="mm"/>
                                            </StackPanel>
                                        </Grid>
                                        <DockPanel Margin="0,10,0,0">
                                            <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Ghost}" Content="Reset palette" c:Ix.Glyph="&#xE72C;"
                                                    Command="{Binding ResetPaletteCommand}"/>
                                            <TextBlock Text="Edits apply to this session. Rebuild the grid after editing." FontSize="10.5"
                                                       Foreground="{StaticResource B.TextFaint}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>
                            </Expander>
                        </StackPanel>
                    </Border>

                    <!-- assigned -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Ghost}" Content="Clear all" c:Ix.Glyph="&#xE74D;"
                                        Command="{Binding ClearSurfacesCommand}"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Assigned surfaces" Style="{StaticResource T.H2}"/>
                                    <TextBlock Text="{Binding AssignedSummary}" Style="{StaticResource T.Muted}" FontSize="11"/>
                                </StackPanel>
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding AssignedMaterials}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,5,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="12" Height="12" CornerRadius="3" Background="{Binding Brush}" Margin="0,0,9,0" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            <Border Grid.Column="2" Style="{StaticResource Chip}" Padding="8,1">
                                                <TextBlock Text="{Binding Count}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource B.TextMuted}"/>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- defaults -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Ground defaults" Style="{StaticResource T.H2}" Margin="0,0,0,10"/>
                            <TextBlock Text="Material for everything you have not assigned" Style="{StaticResource T.Label}"/>
                            <ComboBox ItemsSource="{Binding Materials}" SelectedItem="{Binding DefaultMaterial, Mode=TwoWay}"
                                      ItemTemplate="{StaticResource MaterialCombo}"/>
                            <TextBlock Text="Soil class" Style="{StaticResource T.Label}" Margin="0,10,0,5"/>
                            <ComboBox ItemsSource="{Binding SoilClasses}" SelectedItem="{Binding SelectedSoil, Mode=TwoWay}" DisplayMemberPath="Display"/>
                            <TextBlock Text="How wet is the ground before the storm?" Style="{StaticResource T.Label}" Margin="0,10,0,5"/>
                            <Border Style="{StaticResource SegHost}">
                                <UniformGrid Columns="3">
                                    <RadioButton Style="{StaticResource Seg}" Content="Dry" GroupName="moist"
                                                 IsChecked="{Binding Moisture, Converter={StaticResource IntEq}, ConverterParameter=0}"/>
                                    <RadioButton Style="{StaticResource Seg}" Content="Moist" GroupName="moist"
                                                 IsChecked="{Binding Moisture, Converter={StaticResource IntEq}, ConverterParameter=1}"/>
                                    <RadioButton Style="{StaticResource Seg}" Content="Wet" GroupName="moist"
                                                 IsChecked="{Binding Moisture, Converter={StaticResource IntEq}, ConverterParameter=2}"/>
                                </UniformGrid>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ======================= 3 RAIN ======================= -->
                <StackPanel Visibility="{Binding CurrentStepIndex, Converter={StaticResource IntEq}, ConverterParameter=2}">
                    <StackPanel Margin="2,0,0,14">
                        <TextBlock Text="Rain" Style="{StaticResource T.H1}"/>
                        <TextBlock Text="{Binding Steps[2].Description}" Style="{StaticResource T.Muted}" Margin="0,3,0,0"/>
                    </StackPanel>

                    <Border Style="{StaticResource Card}" Padding="11,12,11,11">
                        <StackPanel>
                            <DockPanel Margin="3,0,3,8">
                                <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Link}" Content="Import CSV…" c:Ix.Glyph="&#xE8E5;"
                                        Command="{Binding ImportCsvCommand}" ToolTip="CSV with rows 'minutes, mm/h'"/>
                                <TextBlock Text="Design event" Style="{StaticResource T.H2}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <ListBox ItemsSource="{Binding RainOptions}" SelectedItem="{Binding SelectedRainOption, Mode=TwoWay}"
                                     ItemContainerStyle="{StaticResource Item.Card}" ItemTemplate="{StaticResource RainCard}">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="2"/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                            </ListBox>

                            <!-- custom -->
                            <Border Style="{StaticResource Inset}" Margin="3,8,3,0" Visibility="{Binding IsCustomRain, Converter={StaticResource Vis}}">
                                <StackPanel>
                                    <Border Style="{StaticResource SegHost}" Background="{StaticResource B.Surface}" Margin="0,0,0,10">
                                        <UniformGrid Columns="2">
                                            <RadioButton Style="{StaticResource Seg}" Content="CDS (Chicago)" GroupName="shape"
                                                         IsChecked="{Binding CustomShape, Converter={StaticResource IntEq}, ConverterParameter=0}"/>
                                            <RadioButton Style="{StaticResource Seg}" Content="Box (constant)" GroupName="shape"
                                                         IsChecked="{Binding CustomShape, Converter={StaticResource IntEq}, ConverterParameter=1}"/>
                                        </UniformGrid>
                                    </Border>
                                    <UniformGrid Columns="3">
                                        <StackPanel Margin="0,0,4,0">
                                            <TextBlock Text="Depth" Style="{StaticResource T.Label}"/>
                                            <TextBox Text="{Binding CustomDepthMm, StringFormat=0.#}" c:Ix.Suffix="mm" ToolTip="0 = from the IDF curve (CDS only)"/>
                                        </StackPanel>
                                        <StackPanel Margin="4,0">
                                            <TextBlock Text="Duration" Style="{StaticResource T.Label}"/>
                                            <TextBox Text="{Binding CustomDurationMin, StringFormat=0}" c:Ix.Suffix="min"/>
                                        </StackPanel>
                                        <StackPanel Margin="4,0,0,0">
                                            <TextBlock Text="Return per." Style="{StaticResource T.Label}"/>
                                            <TextBox Text="{Binding CustomReturnPeriod, StringFormat=0}" c:Ix.Suffix="yr"/>
                                        </StackPanel>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- hyetograph -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Climate factor" FontSize="11" Foreground="{StaticResource B.TextMuted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Width="74" MinHeight="28" Padding="8,4" Text="{Binding ClimateFactor, StringFormat=0.0#}" c:Ix.Suffix="×"
                                             ToolTip="Future rain is heavier: multiplies all rain intensities. Danish practice: 1.2 / 1.3 / 1.4 for 2-, 10- and 100-year storms."/>
                                </StackPanel>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding CurrentRain.Name}" Style="{StaticResource T.H2}"/>
                                    <TextBlock Text="{Binding RainSummary}" FontSize="11" Foreground="{StaticResource B.TextMuted}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DockPanel>
                            <Border Style="{StaticResource Inset}" Padding="8,8,8,6">
                                <c:HyetographChart Height="140" Rain="{Binding CurrentRain}" Version="{Binding RainVersion}"
                                                   LabelBrush="{StaticResource B.Text}" AxisBrush="{StaticResource B.TextMuted}"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- drainage -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Drainage &amp; boundary" Style="{StaticResource T.H2}" Margin="0,0,0,10"/>
                            <TextBlock Text="Where do roofs and paved areas drain? (sewer)" Style="{StaticResource T.Label}"/>
                            <ComboBox ItemsSource="{Binding SewerOptions}" SelectedItem="{Binding SelectedSewer, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Text="{Binding SelectedSewer.Detail}" FontSize="11" Foreground="{StaticResource B.TextMuted}" Margin="2,5,0,0"/>
                            <Grid Margin="0,8,0,0" Visibility="{Binding IsCapacitySewer, Converter={StaticResource Vis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Sewer capacity" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                <TextBox Grid.Column="1" Text="{Binding SewerCapacityMmH, StringFormat=0.#}" c:Ix.Suffix="mm/h"/>
                            </Grid>
                            <TextBlock Text="Site boundary" Style="{StaticResource T.Label}" Margin="0,12,0,5"/>
                            <Border Style="{StaticResource SegHost}">
                                <UniformGrid Columns="2">
                                    <RadioButton Style="{StaticResource Seg}" Content="Open · water leaves" GroupName="bnd"
                                                 ToolTip="Water flowing to the edge leaves the model"
                                                 IsChecked="{Binding BoundaryMode, Converter={StaticResource IntEq}, ConverterParameter=0}"/>
                                    <RadioButton Style="{StaticResource Seg}" Content="Closed · walls" GroupName="bnd"
                                                 ToolTip="The edge acts as a wall; water stays in the model"
                                                 IsChecked="{Binding BoundaryMode, Converter={StaticResource IntEq}, ConverterParameter=1}"/>
                                </UniformGrid>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ======================= 4 SIMULATE ======================= -->
                <StackPanel Visibility="{Binding CurrentStepIndex, Converter={StaticResource IntEq}, ConverterParameter=3}">
                    <StackPanel Margin="2,0,0,10">
                        <TextBlock Text="Simulate" Style="{StaticResource T.H1}"/>
                        <TextBlock Text="{Binding Steps[3].Description}" Style="{StaticResource T.Muted}" Margin="0,3,0,0"/>
                    </StackPanel>
                    <Border Style="{StaticResource Chip}" Margin="0,0,0,12" Padding="10,4" Background="{StaticResource B.Surface2}" HorizontalAlignment="Stretch">
                        <DockPanel>
                            <Path DockPanel.Dock="Left" Data="{StaticResource G.Drop}" Fill="{StaticResource B.Accent}" Width="9" Height="11" Stretch="Uniform" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding ScenarioChip}" FontSize="11" Foreground="{StaticResource B.TextMuted}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ScenarioChip}"/>
                        </DockPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Background="{StaticResource B.WarnSoft}" BorderBrush="Transparent"
                            Visibility="{Binding HasGrid, Converter={StaticResource VisNot}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Link}" Content="Go to Site" Command="{Binding GoToStepCommand}" CommandParameter="0"/>
                            <TextBlock Text="Build the analysis grid first." Foreground="{StaticResource B.Warn}" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>

                    <!-- instant -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,12">
                                <Border Style="{StaticResource CardIcon}" Width="38" Height="38" CornerRadius="11">
                                    <TextBlock Text="&#xE945;" Style="{StaticResource T.Icon}" FontSize="16" Foreground="{StaticResource B.Accent}"/>
                                </Border>
                                <Border DockPanel.Dock="Right" Style="{StaticResource Chip}" VerticalAlignment="Top" Background="{StaticResource B.GoodSoft}">
                                    <TextBlock Text="&lt; 1 s" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource B.Good}"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Quick check" FontSize="15" FontWeight="SemiBold"/>
                                    <TextBlock Text="Where water collects (ponds, also called bluespots) and where it runs, for the total rain. No timing." Style="{StaticResource T.Muted}" FontSize="11" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DockPanel>
                            <Border Style="{StaticResource Inset}" Padding="10,8" Margin="0,0,0,10">
                                <CheckBox IsChecked="{Binding LiveInstant, Mode=TwoWay}">
                                    <StackPanel>
                                        <TextBlock Text="Live" FontWeight="SemiBold"/>
                                        <TextBlock Text="Re-runs automatically when rain, sewer or moisture changes – or when you move or edit picked objects in the model" FontSize="10.5" Foreground="{StaticResource B.TextMuted}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </CheckBox>
                            </Border>
                            <Button Style="{StaticResource Btn.Big}" Content="Run quick check" c:Ix.Glyph="&#xE768;" HorizontalAlignment="Stretch"
                                    Command="{Binding RunInstantCommand}"/>
                            <DockPanel Margin="2,8,0,0">
                                <TextBlock DockPanel.Dock="Left" Text="&#xE916;" FontFamily="{StaticResource F.Icon}" FontSize="11" Foreground="{StaticResource B.TextFaint}" Margin="0,1,6,0"/>
                                <TextBlock Text="{Binding InstantSummary}" FontSize="11" Foreground="{StaticResource B.TextMuted}" TextWrapping="Wrap"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- dynamic -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,12">
                                <Border Style="{StaticResource CardIcon}" Width="38" Height="38" CornerRadius="11">
                                    <Path Data="{StaticResource G.Drop}" Fill="{StaticResource B.Accent}" Width="13" Height="16" Stretch="Uniform"/>
                                </Border>
                                <Border DockPanel.Dock="Right" Style="{StaticResource Chip}" VerticalAlignment="Top" Background="{StaticResource B.AccentSoft}">
                                    <TextBlock Text="2D shallow water" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource B.Accent}"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Full simulation" FontSize="15" FontWeight="SemiBold"/>
                                    <TextBlock Text="Water moving minute by minute: depth, speed and danger to people over time. Takes minutes; you can cancel." Style="{StaticResource T.Muted}" FontSize="11" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DockPanel>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="104"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                    <TextBlock Text="Keep simulating after the rain" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding RunLengthText}" FontSize="10.5" Foreground="{StaticResource B.TextMuted}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <TextBox Grid.Column="1" Text="{Binding AfterRainMin, StringFormat=0}" c:Ix.Suffix="min" VerticalAlignment="Center"
                                         IsEnabled="{Binding IsDynamicRunning, Converter={StaticResource Not}}"/>
                            </Grid>

                            <Grid>
                                <Button Style="{StaticResource Btn.Big}" Content="Run full simulation" c:Ix.Glyph="&#xE768;" HorizontalAlignment="Stretch"
                                        Command="{Binding RunDynamicCommand}" Visibility="{Binding IsDynamicRunning, Converter={StaticResource VisNot}}"/>
                                <Button Style="{StaticResource Btn.Danger}" Content="Cancel run" c:Ix.Glyph="&#xE71A;" HorizontalAlignment="Stretch" Padding="16,11"
                                        Command="{Binding CancelDynamicCommand}" Visibility="{Binding IsDynamicRunning, Converter={StaticResource Vis}}"/>
                            </Grid>

                            <!-- progress -->
                            <Border Style="{StaticResource Inset}" Margin="0,12,0,0" Padding="12,10">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding DynamicPercentText}" FontFamily="{StaticResource F.Display}" FontSize="20"
                                                   FontWeight="SemiBold" Foreground="{StaticResource B.Accent}"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Progress" Style="{StaticResource Metric.Label}"/>
                                            <TextBlock Text="{Binding DynamicSummary}" FontSize="11" Foreground="{StaticResource B.Text}" TextWrapping="Wrap" Margin="0,2,8,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <ProgressBar Value="{Binding DynamicPercent, Mode=OneWay}" Margin="0,8,0,10"/>
                                    <UniformGrid Columns="2">
                                        <StackPanel Margin="0,0,0,8">
                                            <TextBlock Text="Simulated" Style="{StaticResource Metric.Label}"/>
                                            <TextBlock Text="{Binding DynSimText}" Style="{StaticResource Metric.Value}"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,0,8">
                                            <TextBlock Text="Elapsed" Style="{StaticResource Metric.Label}"/>
                                            <TextBlock Text="{Binding DynElapsedText}" Style="{StaticResource Metric.Value}"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="Time left" Style="{StaticResource Metric.Label}"/>
                                            <TextBlock Text="{Binding DynEtaText}" Style="{StaticResource Metric.Value}"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="Deepest so far" Style="{StaticResource Metric.Label}"/>
                                            <TextBlock Text="{Binding DynMaxDepthText}" Style="{StaticResource Metric.Value}"/>
                                        </StackPanel>
                                    </UniformGrid>
                                    <TextBlock Text="{Binding DynDtText}" FontSize="10.5" Foreground="{StaticResource B.TextFaint}" Margin="0,8,0,0"
                                               Visibility="{Binding DynDtText, Converter={StaticResource Has}}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ======================= 5 RESULTS ======================= -->
                <StackPanel Visibility="{Binding CurrentStepIndex, Converter={StaticResource IntEq}, ConverterParameter=4}">
                    <DockPanel Margin="2,0,0,14">
                        <Border DockPanel.Dock="Right" Style="{StaticResource Chip}" Background="{StaticResource B.WarnSoft}" VerticalAlignment="Top"
                                Visibility="{Binding ResultsStale, Converter={StaticResource Vis}}" ToolTip="Inputs changed since this result was computed. Run again to update.">
                            <TextBlock Text="Out of date" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource B.Warn}"/>
                        </Border>
                        <StackPanel>
                            <TextBlock Text="Results" Style="{StaticResource T.H1}"/>
                            <TextBlock Text="{Binding Steps[4].Description}" Style="{StaticResource T.Muted}" Margin="0,3,0,0"/>
                        </StackPanel>
                    </DockPanel>

                    <Border Style="{StaticResource Card}" Visibility="{Binding HasResults, Converter={StaticResource VisNot}}">
                        <StackPanel HorizontalAlignment="Center" Margin="0,8">
                            <Path Data="{StaticResource G.Bars}" Fill="{StaticResource B.TextFaint}" Width="30" Height="26" Stretch="Uniform"/>
                            <TextBlock Text="No results yet" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,2"/>
                            <TextBlock Text="Run the quick check or the full simulation (Simulate step) to see maps here." Style="{StaticResource T.Muted}" TextAlignment="Center" TextWrapping="Wrap"/>
                            <Button Style="{StaticResource Btn.Accent}" Content="Go to Simulate" Margin="0,12,0,0" HorizontalAlignment="Center"
                                    Command="{Binding GoToStepCommand}" CommandParameter="3"/>
                        </StackPanel>
                    </Border>

                    <StackPanel IsEnabled="{Binding IsResultsInteractive}">
                        <!-- layer selector -->
                        <Border Style="{StaticResource Card}" Padding="12">
                            <StackPanel>
                                <Border Style="{StaticResource SegHost}" Margin="0,0,0,10" Visibility="{Binding ShowSourceToggle, Converter={StaticResource Vis}}">
                                    <UniformGrid Columns="2">
                                        <RadioButton Style="{StaticResource Seg}" GroupName="src" Content="Quick check" IsChecked="{Binding SourceIsInstant, Mode=TwoWay}"/>
                                        <RadioButton Style="{StaticResource Seg}" GroupName="src" Content="Full simulation" IsChecked="{Binding SourceIsDynamic, Mode=TwoWay}"/>
                                    </UniformGrid>
                                </Border>
                                <TextBlock Text="Map layer" Style="{StaticResource T.Label}"/>
                                <Border Style="{StaticResource SegHost}">
                                    <ItemsControl ItemsSource="{Binding Layers}" Focusable="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="3"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <RadioButton Style="{StaticResource Seg}" Content="{Binding Title}" Padding="4,7"
                                                             IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding IsAvailable}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>

                                <!-- time -->
                                <Border Style="{StaticResource Inset}" Margin="0,10,0,0" Visibility="{Binding HasFrames, Converter={StaticResource Vis}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Button Grid.RowSpan="2" Width="36" Height="36" Padding="0" c:Ix.Radius="18" c:Ix.GlyphSize="13"
                                                Command="{Binding PlayPauseCommand}" VerticalAlignment="Center" Margin="0,0,10,0" ToolTip="Play / pause the flood over time">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource Btn.Primary}">
                                                    <Setter Property="c:Ix.Glyph" Value="&#xE768;"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                            <Setter Property="c:Ix.Glyph" Value="&#xE769;"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <TextBlock Grid.Column="1" Text="{Binding FrameTimeText}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Bottom"/>
                                        <Button Grid.Column="2" Style="{StaticResource Btn.Link}" Content="Max" Padding="8,2" Command="{Binding ShowMaxCommand}"
                                                ToolTip="Show the maximum depth over the whole run"/>
                                        <Slider Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Minimum="0" Maximum="{Binding FrameMax}" Value="{Binding FrameIndex, Mode=TwoWay}"
                                                TickFrequency="1" IsSnapToTickEnabled="True" SmallChange="1" LargeChange="1"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- legend -->
                        <Border Style="{StaticResource Card}" Visibility="{Binding HasVisual, Converter={StaticResource Vis}}">
                            <StackPanel>
                                <TextBlock Text="{Binding VisualTitle}" Style="{StaticResource T.H2}"/>
                                <TextBlock Text="{Binding LegendTitle}" FontSize="11" Foreground="{StaticResource B.TextMuted}" Margin="0,1,0,8"/>
                                <ItemsControl ItemsSource="{Binding Legend}" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="2"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,2,6,2" ToolTip="{Binding Label}">
                                                <Border Width="18" Height="11" CornerRadius="3" Background="{Binding Brush}" BorderBrush="#30FFFFFF" BorderThickness="1"
                                                        Margin="0,0,7,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Label}" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- stats -->
                        <Border Style="{StaticResource Card}" Visibility="{Binding HasResults, Converter={StaticResource Vis}}" Padding="11,12">
                            <StackPanel>
                                <TextBlock Text="Key figures" Style="{StaticResource T.H2}" Margin="3,0,0,0"/>
                                <TextBlock Text="{Binding StatModel}" FontSize="11" Foreground="{StaticResource B.TextMuted}" Margin="3,1,0,8" TextTrimming="CharacterEllipsis"/>
                                <UniformGrid Columns="2">
                                    <c:StatTile Label="Flooded volume" Value="{Binding StatVolume}" Unit="m³" Note="{Binding StatVolumeNote}" Tone="Accent"/>
                                    <c:StatTile Label="Area deeper than 10 cm" Value="{Binding StatArea}" Unit="m²" Tone="{Binding StatAreaTone}"
                                                Note="Copenhagen 10 cm goal" ToolTip="Area with water deeper than 10 cm. Above zero breaks the Copenhagen cloudburst target."/>
                                    <c:StatTile Label="Max depth" Value="{Binding StatMaxDepth}" Unit="m"/>
                                    <c:StatTile Label="Bluespots" Value="{Binding StatBluespots}" Note="{Binding StatBluespotsNote}"/>
                                    <c:StatTile Label="Rain in" Value="{Binding StatRain}" Unit="m³" Note="{Binding StatRainNote}"/>
                                    <c:StatTile Label="Analysis grid" Value="{Binding GridCellsText}" Unit="cells" Note="{Binding GridDimsText}"/>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <!-- mass balance -->
                        <Border Style="{StaticResource Card}">
                            <Border.Visibility>
                                <MultiBinding Converter="{x:Static inf:AllTrue.Instance}">
                                    <Binding Path="HasMass"/>
                                    <Binding Path="IsDynamicSource"/>
                                </MultiBinding>
                            </Border.Visibility>
                            <StackPanel>
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                                        <TextBlock Text="Book-keeping error" FontSize="10.5" Foreground="{StaticResource B.TextMuted}" HorizontalAlignment="Right" ToolTip="Rain in minus water out and stored. Under 0.1 % is good."/>
                                        <TextBlock Text="{Binding MassErrorText}" FontWeight="SemiBold" Foreground="{StaticResource B.Good}" HorizontalAlignment="Right"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Where did the water go?" Style="{StaticResource T.H2}"/>
                                        <TextBlock Text="{Binding MassTotalText}" FontSize="11" Foreground="{StaticResource B.TextMuted}"/>
                                    </StackPanel>
                                </DockPanel>
                                <c:StackedBar Height="14" Margin="0,10,0,10" Segments="{Binding MassSegments}" TrackBrush="{StaticResource B.Surface3}"/>
                                <ItemsControl ItemsSource="{Binding MassSegments}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="56"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="10" Height="10" CornerRadius="5" Background="{Binding Brush}" Margin="0,0,9,0" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="11.5"/>
                                                <TextBlock Grid.Column="2" Text="{Binding ValueText}" FontSize="11.5" FontWeight="SemiBold"/>
                                                <TextBlock Grid.Column="3" Text="{Binding PercentText}" FontSize="11" Foreground="{StaticResource B.TextMuted}" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- bluespots table -->
                        <Border Style="{StaticResource Card}" Visibility="{Binding HasBluespots, Converter={StaticResource Vis}}">
                            <StackPanel>
                                <TextBlock Text="Largest ponds (bluespots)" Style="{StaticResource T.H2}"/>
                                <TextBlock Text="Top 10 by volume (quick check). Overflows at = the rain depth at which the pond is full and spills over." FontSize="11"
                                           Foreground="{StaticResource B.TextMuted}" TextWrapping="Wrap" Margin="0,1,0,8"/>
                                <Grid Margin="6,0,6,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="#" Style="{StaticResource T.Overline}"/>
                                    <TextBlock Grid.Column="1" Text="VOLUME m³" Style="{StaticResource T.Overline}" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Column="2" Text="DEPTH cm" Style="{StaticResource T.Overline}" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Column="3" Text="AREA m²" Style="{StaticResource T.Overline}" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Column="4" Text="OVERFLOWS AT mm" Style="{StaticResource T.Overline}" HorizontalAlignment="Right"/>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Bluespots}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="Row" CornerRadius="6" Padding="6,5" Background="{StaticResource B.Surface2}" Margin="0,1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="24"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Rank}" Foreground="{StaticResource B.TextFaint}" FontSize="11.5"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Volume}" FontWeight="SemiBold" FontSize="11.5" HorizontalAlignment="Right"/>
                                                    <TextBlock x:Name="Depth" Grid.Column="2" Text="{Binding Depth}" FontSize="11.5" HorizontalAlignment="Right"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding Area}" FontSize="11.5" HorizontalAlignment="Right" Foreground="{StaticResource B.TextMuted}"/>
                                                    <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right">
                                                        <Ellipse x:Name="SpillDot" Width="6" Height="6" Fill="{StaticResource B.Danger}" Margin="0,0,5,0" VerticalAlignment="Center"
                                                                 Visibility="Collapsed" ToolTip="Spills over at this rain"/>
                                                        <TextBlock Text="{Binding SpillRain}" FontSize="11.5" Foreground="{StaticResource B.TextMuted}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Deep}" Value="True">
                                                    <Setter TargetName="Depth" Property="Foreground" Value="{StaticResource B.Danger}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Spills}" Value="True">
                                                    <Setter TargetName="SpillDot" Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- actions -->
                        <Grid Margin="0,0,0,6" Visibility="{Binding HasGrid, Converter={StaticResource Vis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Style="{StaticResource Btn.Primary}" Content="Bake to model" c:Ix.Glyph="&#xE78C;" Padding="10,9"
                                    Command="{Binding BakeCommand}" ToolTip="Add the current map as permanent geometry"/>
                            <Button Grid.Column="2" Content="Clear preview" c:Ix.Glyph="&#xE894;" Padding="10,9" Command="{Binding ClearPreviewCommand}"/>
                        </Grid>
                        <Button Style="{StaticResource Btn.Link}" Content="Export current layer as .asc…" c:Ix.Glyph="&#xE896;" HorizontalAlignment="Center"
                                Command="{Binding ExportAscCommand}" Margin="0,0,0,12" Visibility="{Binding HasResults, Converter={StaticResource Vis}}"
                                ToolTip="Esri ASCII grid, georeferenced to the analysis grid"/>
                    </StackPanel>
                </StackPanel>

                <!-- ======================= 6 COMPARE & RETENTION ======================= -->
                <StackPanel Visibility="{Binding CurrentStepIndex, Converter={StaticResource IntEq}, ConverterParameter=5}">
                    <StackPanel Margin="2,0,0,14">
                        <TextBlock Text="Compare &amp; retention" Style="{StaticResource T.H1}"/>
                        <TextBlock Text="{Binding Steps[5].Description}" Style="{StaticResource T.Muted}" Margin="0,3,0,0"/>
                    </StackPanel>

                    <!-- save -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Design options" Style="{StaticResource T.H2}"/>
                            <TextBlock Text="Save the latest result as an option (the full simulation if you ran one). Change the design, save again, then compare." Style="{StaticResource T.Muted}" FontSize="11" Margin="0,1,0,10" TextWrapping="Wrap"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding OptionName, UpdateSourceTrigger=PropertyChanged}" c:Ix.Placeholder="Option name"/>
                                <Button Grid.Column="2" Style="{StaticResource Btn.Primary}" Content="Save option" c:Ix.Glyph="&#xE74E;" Command="{Binding SaveOptionCommand}"/>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding SavedOptions}" Margin="0,8,0,0" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Inset}" Padding="8,7" Margin="0,4,0,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="28" Height="28" CornerRadius="14" Background="{StaticResource B.AccentSoft}" Margin="0,0,10,0">
                                                    <TextBlock Text="{Binding Letter}" FontWeight="Bold" Foreground="{StaticResource B.Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                                                        <Run Text="{Binding Name, Mode=OneWay}"/>
                                                        <Run Text="{Binding Model, Mode=OneWay}" Foreground="{StaticResource B.TextFaint}" FontWeight="Normal" FontSize="10.5"/>
                                                    </TextBlock>
                                                    <TextBlock FontSize="11" Foreground="{StaticResource B.TextMuted}" TextTrimming="CharacterEllipsis">
                                                        <Run Text="{Binding VolumeText, Mode=OneWay}"/>
                                                        <Run Text="·"/>
                                                        <Run Text="{Binding AreaText, Mode=OneWay}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                                <Button Grid.Column="2" Style="{StaticResource Btn.Icon}" c:Ix.Glyph="&#xE74D;" ToolTip="Remove"
                                                        Command="{Binding DataContext.RemoveOptionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- compare -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Compare two options" Style="{StaticResource T.H2}" Margin="0,0,0,10"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="A (baseline)" Style="{StaticResource T.Label}"/>
                                    <ComboBox ItemsSource="{Binding SavedOptions}" SelectedItem="{Binding CompareA, Mode=TwoWay}" DisplayMemberPath="Name"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="&#xE72A;" FontFamily="{StaticResource F.Icon}" FontSize="11" Foreground="{StaticResource B.TextFaint}"
                                           HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10"/>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="B (design)" Style="{StaticResource T.Label}"/>
                                    <ComboBox ItemsSource="{Binding SavedOptions}" SelectedItem="{Binding CompareB, Mode=TwoWay}" DisplayMemberPath="Name"/>
                                </StackPanel>
                            </Grid>
                            <Button Style="{StaticResource Btn.Accent}" Content="Show what changed (B vs A)" c:Ix.Glyph="&#xE8AB;" Margin="0,12,0,0" Padding="12,9"
                                    HorizontalAlignment="Stretch" Command="{Binding CompareCommand}"/>
                            <StackPanel Visibility="{Binding HasComparison, Converter={StaticResource Vis}}" Margin="0,10,0,0">
                                <TextBlock Text="{Binding CmpTitle}" FontWeight="SemiBold" Margin="3,0,0,4"/>
                                <UniformGrid Columns="2" Margin="-3,0">
                                    <c:StatTile Label="Volume change" Value="{Binding CmpVolumeText}" Unit="m³" Tone="{Binding CmpVolumeTone}" Note="{Binding CmpVolumeNote}"/>
                                    <c:StatTile Label="Area &gt; 10 cm change" Value="{Binding CmpAreaText}" Unit="m²" Tone="{Binding CmpAreaTone}" Note="{Binding CmpAreaNote}"/>
                                </UniformGrid>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- retention -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,10">
                                <Border DockPanel.Dock="Right" Style="{StaticResource Chip}" Background="{StaticResource B.WarnSoft}" VerticalAlignment="Top"
                                        ToolTip="Rational-method sizing for early design. Not a substitute for a detailed drainage design.">
                                    <TextBlock Text="Indicative" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource B.Warn}"/>
                                </Border>
                                <StackPanel>
                                    <TextBlock Text="Retention volume" Style="{StaticResource T.H2}"/>
                                    <TextBlock Text="Storage needed to throttle the site to the discharge limit" Style="{StaticResource T.Muted}" FontSize="11"/>
                                </StackPanel>
                            </DockPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock Text="Return period" Style="{StaticResource T.Label}"/>
                                    <ComboBox ItemsSource="{Binding ReturnPeriods}" SelectedItem="{Binding RetReturnPeriod, Mode=TwoWay}" ItemStringFormat="T = {0} years"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="0,0,0,8">
                                    <TextBlock Text="Climate factor" Style="{StaticResource T.Label}"/>
                                    <TextBox Text="{Binding RetClimateFactor, StringFormat=0.0#}" c:Ix.Suffix="×"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1">
                                    <TextBlock Text="Discharge limit" Style="{StaticResource T.Label}"/>
                                    <TextBox Text="{Binding RetDischarge, StringFormat=0.0#}" c:Ix.Suffix="l/s/ha"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="2">
                                    <TextBlock Text="Safety factor" Style="{StaticResource T.Label}"/>
                                    <TextBox Text="{Binding RetSafety, StringFormat=0.0#}" c:Ix.Suffix="×"/>
                                </StackPanel>
                            </Grid>
                            <Button Style="{StaticResource Btn.Accent}" Content="Calculate retention" c:Ix.Glyph="&#xE8EF;" Margin="0,12,0,0" Padding="12,9"
                                    HorizontalAlignment="Stretch" Command="{Binding RetentionCommand}"/>

                            <Border Margin="0,12,0,0" CornerRadius="12" Padding="14,12" Background="{StaticResource B.HeroGradient}" BorderBrush="{StaticResource B.AccentLine}"
                                    BorderThickness="1" Visibility="{Binding HasRetention, Converter={StaticResource Vis}}">
                                <StackPanel>
                                    <TextBlock Text="Required storage" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource B.TextMuted}"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding RetStorage}" FontFamily="{StaticResource F.Display}" FontSize="34" FontWeight="SemiBold" Foreground="{StaticResource B.Accent}"/>
                                        <TextBlock Text="m³" FontSize="15" Foreground="{StaticResource B.TextMuted}" VerticalAlignment="Bottom" Margin="6,0,0,8"/>
                                    </StackPanel>
                                    <Border Style="{StaticResource Divider}" Margin="0,8"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Total area" Style="{StaticResource Metric.Label}" Margin="0,2"/>
                                        <TextBlock Grid.Column="1" Margin="0,2"><Run Text="{Binding RetTotalArea, Mode=OneWay}" FontWeight="SemiBold"/> m²</TextBlock>
                                        <TextBlock Grid.Row="1" Text="Effective sealed area (C × A)" Style="{StaticResource Metric.Label}" Margin="0,2"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,2"><Run Text="{Binding RetReducedArea, Mode=OneWay}" FontWeight="SemiBold"/> m²</TextBlock>
                                        <TextBlock Grid.Row="2" Text="Mean runoff coefficient" Style="{StaticResource Metric.Label}" Margin="0,2"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,2" Text="{Binding RetMeanC}" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Row="3" Text="Peak flow (rational)" Style="{StaticResource Metric.Label}" Margin="0,2"/>
                                        <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,2"><Run Text="{Binding RetPeak, Mode=OneWay}" FontWeight="SemiBold"/> l/s</TextBlock>
                                        <TextBlock Grid.Row="4" Text="Allowed outflow" Style="{StaticResource Metric.Label}" Margin="0,2"/>
                                        <TextBlock Grid.Row="4" Grid.Column="1" Margin="0,2"><Run Text="{Binding RetOutflow, Mode=OneWay}" FontWeight="SemiBold"/> l/s</TextBlock>
                                        <TextBlock Grid.Row="5" Text="Longest storm to store (critical duration)" Style="{StaticResource Metric.Label}" Margin="0,2"/>
                                        <TextBlock Grid.Row="5" Grid.Column="1" Margin="0,2" Text="{Binding RetCritical}" FontWeight="SemiBold"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- next step -->
                <Button Style="{StaticResource Btn.Ghost}" HorizontalAlignment="Right" Command="{Binding NextStepCommand}" Margin="0,0,0,8"
                        Visibility="{Binding HasNextStep, Converter={StaticResource Vis}}" Foreground="{StaticResource B.Accent}" c:Ix.Hover="{StaticResource B.AccentSoft2}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding NextStepTitle}"/>
                        <TextBlock Text="&#xE72A;" FontFamily="{StaticResource F.Icon}" FontSize="11" Margin="8,1,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </ScrollViewer>

        <!-- ============================== FOOTER ============================== -->
        <Border Grid.Row="4" Background="{StaticResource B.Surface}" BorderBrush="{StaticResource B.Border}" BorderThickness="0,1,0,0" Padding="12,8,12,10">
            <StackPanel>
                <Border x:Name="Toast" CornerRadius="9" Padding="10,7" Margin="0,0,0,7" BorderThickness="1"
                        Visibility="{Binding HasStatus, Converter={StaticResource Vis}}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{StaticResource B.Surface2}"/>
                            <Setter Property="BorderBrush" Value="{StaticResource B.Border}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusKind}" Value="Success">
                                    <Setter Property="Background" Value="{StaticResource B.GoodSoft}"/>
                                    <Setter Property="BorderBrush" Value="#4434D399"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding StatusKind}" Value="Warning">
                                    <Setter Property="Background" Value="{StaticResource B.WarnSoft}"/>
                                    <Setter Property="BorderBrush" Value="#44FBBF24"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding StatusKind}" Value="Error">
                                    <Setter Property="Background" Value="{StaticResource B.DangerSoft}"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource B.DangerLine}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" FontFamily="{StaticResource F.Icon}" FontSize="12" Margin="0,1,9,0" VerticalAlignment="Top">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="&#xE946;"/>
                                    <Setter Property="Foreground" Value="{StaticResource B.Accent}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StatusKind}" Value="Success">
                                            <Setter Property="Text" Value="&#xE73E;"/>
                                            <Setter Property="Foreground" Value="{StaticResource B.Good}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding StatusKind}" Value="Warning">
                                            <Setter Property="Text" Value="&#xE7BA;"/>
                                            <Setter Property="Foreground" Value="{StaticResource B.Warn}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding StatusKind}" Value="Error">
                                            <Setter Property="Text" Value="&#xE783;"/>
                                            <Setter Property="Foreground" Value="{StaticResource B.Danger}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Icon}" Width="20" Height="20" Padding="0" c:Ix.Glyph="&#xE711;" c:Ix.GlyphSize="9"
                                Command="{Binding DismissStatusCommand}" Margin="6,-2,-4,0" VerticalAlignment="Top" ToolTip="Dismiss"/>
                        <TextBlock Text="{Binding StatusText}" FontSize="11.5" TextWrapping="Wrap" Foreground="{StaticResource B.Text}"/>
                    </DockPanel>
                </Border>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding BusyText}" FontSize="10.5" Foreground="{StaticResource B.Accent}" Margin="8,0,0,0"
                               MaxWidth="160" TextTrimming="CharacterEllipsis" Visibility="{Binding IsBusy, Converter={StaticResource Vis}}"/>
                    <TextBlock Text="{Binding Caption}" FontSize="10" Foreground="{StaticResource B.TextFaint}" TextWrapping="Wrap"/>
                </DockPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
